FROM --platform=linux/arm64 ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401 AS emulator
RUN apt-get update && apt-get install -y --no-install-recommends qemu-user-static && rm -rf /var/lib/apt/lists/*
FROM pdc-quartus-runtime
COPY --from=emulator /usr/bin/qemu-x86_64-static /usr/local/bin/qemu-x86_64-static
